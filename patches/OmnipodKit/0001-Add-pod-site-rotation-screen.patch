+/// Double-headed arrow drawn pointing up/down in a 24x24 box; each end is colored separately
+/// so the selected end shows which way the pod faces.
+private struct PodSiteArrow: View {
+    let firstColor: Color
+    let secondColor: Color
+    let firstEmphasized: Bool
+    let secondEmphasized: Bool
+
+    var body: some View {
+        ZStack {
+            ArrowHalf(pointingUp: true).stroke(Color.white, style: StrokeStyle(lineWidth: 6 * scale, lineCap: .round, lineJoin: .round))
+            ArrowHalf(pointingUp: false).stroke(Color.white, style: StrokeStyle(lineWidth: 6 * scale, lineCap: .round, lineJoin: .round))
+            ArrowHalf(pointingUp: true).stroke(firstColor, style: StrokeStyle(lineWidth: (firstEmphasized ? 3.2 : 2.4) * scale, lineCap: .round, lineJoin: .round))
+            ArrowHalf(pointingUp: false).stroke(secondColor, style: StrokeStyle(lineWidth: (secondEmphasized ? 3.2 : 2.4) * scale, lineCap: .round, lineJoin: .round))
+        }
+    }
+
+    private var scale: CGFloat { 56.0 / 24.0 }
+
+    private struct ArrowHalf: Shape {
+        let pointingUp: Bool
+
+        func path(in rect: CGRect) -> Path {
+            let s = min(rect.width, rect.height) / 24
+            func pt(_ x: CGFloat, _ y: CGFloat) -> CGPoint {
+                CGPoint(x: rect.minX + x * s, y: rect.minY + y * s)
+            }
+            var p = Path()
+            let tipY: CGFloat = pointingUp ? 2.5 : 21.5
+            let barbY: CGFloat = pointingUp ? 7.5 : 16.5
+            p.move(to: pt(12, 12))
+            p.addLine(to: pt(12, tipY))
+            p.move(to: pt(7, barbY))
+            p.addLine(to: pt(12, tipY))
+            p.addLine(to: pt(17, barbY))
+            return p
+        }
+    }
+}
+
+/// Rounded-triangle pod outline, tip pointing up.
+private struct PodShape: Shape {
+    func path(in rect: CGRect) -> Path {
+        let sx = rect.width / 34
+        let sy = rect.height / 36
+        func pt(_ x: CGFloat, _ y: CGFloat) -> CGPoint {
+            CGPoint(x: rect.minX + (x - 7) * sx, y: rect.minY + (y - 6) * sy)
+        }
+        var p = Path()
+        p.move(to: pt(24, 6))
+        p.addCurve(to: pt(28.6, 9.6), control1: pt(26, 6), control2: pt(27.5, 7.5))
+        p.addLine(to: pt(39.4, 33.4))
+        p.addCurve(to: pt(34, 42), control1: pt(41.4, 37.8), control2: pt(38.8, 42))
+        p.addLine(to: pt(14, 42))
+        p.addCurve(to: pt(8.6, 33.4), control1: pt(9.2, 42), control2: pt(6.6, 37.8))
+        p.addLine(to: pt(19.4, 9.6))
+        p.addCurve(to: pt(24, 6), control1: pt(20.5, 7.5), control2: pt(22, 6))
+        p.closeSubpath()
+        return p
+    }
+}
