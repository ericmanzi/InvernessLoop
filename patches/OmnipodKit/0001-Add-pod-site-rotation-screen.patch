diff --git a/OmnipodKit/PumpManagerUI/Views/PodSiteSelectionView.swift b/OmnipodKit/PumpManagerUI/Views/PodSiteSelectionView.swift
new file mode 100644
index 0000000..0dedd04
--- /dev/null
+++ b/OmnipodKit/PumpManagerUI/Views/PodSiteSelectionView.swift
@@ -0,0 +1,865 @@
+//
+//  PodSiteSelectionView.swift
+//  OmnipodKit
+//
+//  Pod site rotation: after a new pod's cannula is inserted, the user logs
+//  where on the body the pod was placed and which way it faces, so sites can
+//  be rotated and skin given time to heal.
+//
+
+import SwiftUI
+import LoopKitUI
+
+// MARK: - Model
+
+enum PodSiteBodyView: String, Codable {
+    case front
+    case back
+}
+
+enum PodSiteOrientation: String, Codable {
+    case up
+    case down
+    case left
+    case right
+
+    var localizedLabel: String {
+        switch self {
+        case .up: return LocalizedString("Facing up", comment: "Pod site orientation: pod tip faces the head")
+        case .down: return LocalizedString("Facing down", comment: "Pod site orientation: pod tip faces the feet")
+        case .left: return LocalizedString("Facing left", comment: "Pod site orientation: pod tip faces the wearer's left")
+        case .right: return LocalizedString("Facing right", comment: "Pod site orientation: pod tip faces the wearer's right")
+        }
+    }
+
+    var localizedHint: String {
+        switch self {
+        case .up: return LocalizedString("Tip toward head", comment: "Pod site orientation hint for facing up")
+        case .down: return LocalizedString("Tip toward feet", comment: "Pod site orientation hint for facing down")
+        case .left: return LocalizedString("Tip toward your left", comment: "Pod site orientation hint for facing left")
+        case .right: return LocalizedString("Tip toward your right", comment: "Pod site orientation hint for facing right")
+        }
+    }
+
+    /// Rotation of an up-pointing arrow so it points this way on screen.
+    /// Front view is mirrored (the wearer's left is on screen right), back view is not.
+    func screenRotation(in bodyView: PodSiteBodyView) -> Double {
+        switch self {
+        case .up: return 0
+        case .down: return 180
+        case .left: return bodyView == .front ? 90 : -90
+        case .right: return bodyView == .front ? -90 : 90
+        }
+    }
+}
+
+enum PodSite: String, Codable, CaseIterable, Identifiable {
+    case rightOuterThigh
+    case leftOuterThigh
+    case leftUpperButtock
+    case rightUpperButtock
+
+    var id: String { rawValue }
+
+    var bodyView: PodSiteBodyView {
+        switch self {
+        case .rightOuterThigh, .leftOuterThigh: return .front
+        case .leftUpperButtock, .rightUpperButtock: return .back
+        }
+    }
+
+    var localizedName: String {
+        switch self {
+        case .rightOuterThigh: return LocalizedString("Right outer thigh", comment: "Pod site name")
+        case .leftOuterThigh: return LocalizedString("Left outer thigh", comment: "Pod site name")
+        case .leftUpperButtock: return LocalizedString("Left upper buttock", comment: "Pod site name")
+        case .rightUpperButtock: return LocalizedString("Right upper buttock", comment: "Pod site name")
+        }
+    }
+
+    /// The two directions the pod can face at this site: front sites face up or down,
+    /// back sites face left or right.
+    var orientations: [PodSiteOrientation] {
+        bodyView == .front ? [.up, .down] : [.left, .right]
+    }
+
+    /// Marker position in diagram coordinates (see `PodSiteBodyDiagram`).
+    /// The front view is drawn mirrored, so the wearer's right thigh is on screen left.
+    var diagramPoint: CGPoint {
+        switch self {
+        case .rightOuterThigh: return CGPoint(x: 70, y: 236)
+        case .leftOuterThigh: return CGPoint(x: 130, y: 236)
+        case .leftUpperButtock: return CGPoint(x: 85, y: 205)
+        case .rightUpperButtock: return CGPoint(x: 115, y: 205)
+        }
+    }
+}
+
+struct PodSiteEntry: Codable, Equatable {
+    var site: PodSite
+    var orientation: PodSiteOrientation
+    var date: Date
+    var podAddress: UInt32?
+}
+
+/// On-device history of logged pod sites, newest last.
+final class PodSiteLog: ObservableObject {
+    static let shared = PodSiteLog()
+
+    private let defaults: UserDefaults
+    private let storageKey = "com.loopkit.OmnipodKit.PodSiteLog.entries"
+    private let maxEntries = 500
+
+    init(defaults: UserDefaults = .standard) {
+        self.defaults = defaults
+    }
+
+    var entries: [PodSiteEntry] {
+        guard let data = defaults.data(forKey: storageKey),
+              let decoded = try? JSONDecoder().decode([PodSiteEntry].self, from: data)
+        else {
+            return []
+        }
+        return decoded
+    }
+
+    var latest: PodSiteEntry? {
+        entries.last
+    }
+
+    func record(_ entry: PodSiteEntry) {
+        var all = entries
+        // Logging the same pod again replaces its earlier entry.
+        if let address = entry.podAddress {
+            all.removeAll { $0.podAddress == address }
+        }
+        all.append(entry)
+        if all.count > maxEntries {
+            all.removeFirst(all.count - maxEntries)
+        }
+        if let data = try? JSONEncoder().encode(all) {
+            objectWillChange.send()
+            defaults.set(data, forKey: storageKey)
+        }
+    }
+
+    /// The logged site of the pod with this address, if any.
+    func entry(forPodAddress address: UInt32?) -> PodSiteEntry? {
+        guard let address = address else { return nil }
+        return entries.last(where: { $0.podAddress == address })
+    }
+
+    func lastUsed(_ site: PodSite) -> Date? {
+        entries.last(where: { $0.site == site })?.date
+    }
+}
+
+// MARK: - Palette
+
+private enum PodSitePalette {
+    static func color(_ hex: UInt32) -> Color {
+        Color(
+            red: Double((hex >> 16) & 0xFF) / 255,
+            green: Double((hex >> 8) & 0xFF) / 255,
+            blue: Double(hex & 0xFF) / 255
+        )
+    }
+
+    static let skin = color(0x8D5B3E)
+    static let skinLight = color(0xA06C4C)
+    static let skinShadow = color(0x6B402A)
+    static let skinLine = color(0x4E2C1C)
+
+    static let previousPod = color(0x3A3A3F)
+    static let recent = color(0xF4B04A)
+    static let rested = color(0x2E9D6F)
+    static let inactiveEnd = color(0xC7C7CC)
+}
+
+private enum PodSiteStatus {
+    case previousPod
+    case recent
+    case rested
+
+    var color: Color {
+        switch self {
+        case .previousPod: return PodSitePalette.previousPod
+        case .recent: return PodSitePalette.recent
+        case .rested: return PodSitePalette.rested
+        }
+    }
+
+    var localizedDescription: String {
+        switch self {
+        case .previousPod: return LocalizedString("previous pod", comment: "Accessibility status of a pod site used by the previous pod")
+        case .recent: return LocalizedString("used recently", comment: "Accessibility status of a pod site used in the last 10 days")
+        case .rested: return LocalizedString("rested", comment: "Accessibility status of a pod site not used in the last 10 days")
+        }
+    }
+}
+
+// MARK: - Screen
+
+struct PodSiteSelectionView: View {
+
+    @Environment(\.presentationMode) private var presentationMode
+
+    private let podAddress: UInt32?
+    /// True during pod setup; false when opened from Pod Settings to check or change the site.
+    private let isSetupFlow: Bool
+    private let onFinish: (() -> Void)?
+    private let didRequestDeactivation: () -> Void
+    private let log: PodSiteLog
+    private let previousEntry: PodSiteEntry?
+    private let insertedAt: Date
+
+    @State private var bodyView: PodSiteBodyView = .front
+    @State private var selectedSite: PodSite?
+    @State private var orientation: PodSiteOrientation = .up
+    @State private var cancelModalIsPresented = false
+
+    private static let recentInterval: TimeInterval = 10 * 24 * 60 * 60
+
+    init(
+        podAddress: UInt32?,
+        isSetupFlow: Bool = true,
+        insertedAt: Date? = nil,
+        log: PodSiteLog = .shared,
+        onFinish: (() -> Void)? = nil,
+        didRequestDeactivation: @escaping () -> Void = {}
+    ) {
+        self.podAddress = podAddress
+        self.isSetupFlow = isSetupFlow
+        self.log = log
+        self.onFinish = onFinish
+        self.didRequestDeactivation = didRequestDeactivation
+        // The newest entry belongs to the previous pod, unless it is this pod's own entry.
+        self.previousEntry = log.entries.last(where: { podAddress == nil || $0.podAddress != podAddress })
+
+        // Reopening for a pod that was already logged shows its saved site.
+        let existing = log.entry(forPodAddress: podAddress)
+        self.insertedAt = existing?.date ?? insertedAt ?? Date()
+        if let existing = existing {
+            _selectedSite = State(initialValue: existing.site)
+            _orientation = State(initialValue: existing.orientation)
+            _bodyView = State(initialValue: existing.site.bodyView)
+        }
+    }
+
+    /// Saving needs a pod to attach the site to; without one the screen is view-only.
+    private var canSave: Bool {
+        isSetupFlow || podAddress != nil
+    }
+
+    private func finish() {
+        if let onFinish = onFinish {
+            onFinish()
+        } else {
+            presentationMode.wrappedValue.dismiss()
+        }
+    }
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ScrollView {
+                VStack(alignment: .leading, spacing: 18) {
+                    header
+                    bodyViewPicker
+                    diagramCard
+                    suggestionButton
+                    detailsCard
+                    orientationSection
+                }
+                .padding(.horizontal, 20)
+                .padding(.vertical, 16)
+            }
+            actionButtons
+        }
+        .background(Color(UIColor.systemGroupedBackground).edgesIgnoringSafeArea(.all))
+        .alert(isPresented: $cancelModalIsPresented) { cancelPairingModal }
+        .navigationTitle(LocalizedString("Pod Site", comment: "navigation title for pod site selection"))
+        .navigationBarTitleDisplayMode(.inline)
+        .navigationBarItems(trailing: isSetupFlow ? AnyView(cancelButton) : AnyView(EmptyView()))
+        .navigationBarBackButtonHidden(isSetupFlow)
+    }
+
+    // MARK: Sections
+
+    private var header: some View {
+        VStack(alignment: .leading, spacing: 6) {
+            Text(LocalizedString("Where did you place this pod?", comment: "Pod site selection title"))
+                .font(.title2)
+                .bold()
+                .fixedSize(horizontal: false, vertical: true)
+            Text(canSave
+                 ? LocalizedString("Logging each site helps you rotate and give skin time to heal.", comment: "Pod site selection description")
+                 : LocalizedString("See which site has rested longest before you place your next pod.", comment: "Pod site description when no pod is active"))
+                .font(.subheadline)
+                .foregroundColor(.secondary)
+                .fixedSize(horizontal: false, vertical: true)
+        }
+    }
+
+    private var bodyViewPicker: some View {
+        Picker(LocalizedString("Body view", comment: "Accessibility label for the front/back body view picker"), selection: $bodyView) {
+            Text(LocalizedString("Front", comment: "Front body view")).tag(PodSiteBodyView.front)
+            Text(LocalizedString("Back", comment: "Back body view")).tag(PodSiteBodyView.back)
+        }
+        .pickerStyle(.segmented)
+    }
+
+    private var diagramCard: some View {
+        VStack(spacing: 12) {
+            HStack {
+                Text(bodyView == .front
+                     ? LocalizedString("Your right", comment: "Edge label: wearer's right side")
+                     : LocalizedString("Your left", comment: "Edge label: wearer's left side"))
+                Spacer()
+                Text(bodyView == .front
+                     ? LocalizedString("Your left", comment: "Edge label: wearer's left side")
+                     : LocalizedString("Your right", comment: "Edge label: wearer's right side"))
+            }
+            .font(.caption.weight(.semibold))
+            .textCase(.uppercase)
+            .foregroundColor(.secondary)
+            .padding(.horizontal, 8)
+
+            ZStack(alignment: .topLeading) {
+                PodSiteBodyDiagram(bodyView: bodyView)
+                ForEach(PodSite.allCases.filter { $0.bodyView == bodyView }) { site in
+                    siteMarker(site)
+                }
+            }
+            .frame(width: PodSiteBodyDiagram.size.width, height: PodSiteBodyDiagram.size.height)
+            .clipped()
+
+            HStack(spacing: 14) {
+                legendItem(PodSitePalette.previousPod, LocalizedString("Previous pod", comment: "Pod site legend: previous pod"))
+                legendItem(PodSitePalette.recent, LocalizedString("Used < 10 days", comment: "Pod site legend: used in last 10 days"))
+                legendItem(PodSitePalette.rested, LocalizedString("Rested", comment: "Pod site legend: rested site"))
+            }
+            .font(.caption)
+            .foregroundColor(.secondary)
+        }
+        .padding(.top, 16)
+        .padding(.horizontal, 12)
+        .padding(.bottom, 12)
+        .frame(maxWidth: .infinity)
+        .background(Color(UIColor.secondarySystemGroupedBackground))
+        .cornerRadius(14)
+    }
+
+    @ViewBuilder
+    private var suggestionButton: some View {
+        if let suggested = suggestedSite, suggested != selectedSite {
+            Button(action: { select(suggested, orientation: suggested.orientations[0]) }) {
+                HStack(spacing: 10) {
+                    Image(systemName: "star")
+                        .font(.body.weight(.semibold))
+                    VStack(alignment: .leading, spacing: 2) {
+                        Text(String(format: LocalizedString("Suggested: %1$@", comment: "Suggested pod site (1: site name)"), suggested.localizedName))
+                            .bold()
+                        Text(suggestionDetail(for: suggested))
+                    }
+                    .font(.subheadline)
+                    Spacer()
+                }
+                .padding(.horizontal, 14)
+                .padding(.vertical, 12)
+                .foregroundColor(PodSitePalette.color(0x145C3F))
+                .background(PodSitePalette.color(0xE6F4EE))
+                .cornerRadius(12)
+            }
+            .buttonStyle(.plain)
+        }
+    }
+
+    private var detailsCard: some View {
+        VStack(spacing: 0) {
+            detailRow(LocalizedString("Site", comment: "Pod site detail row label"),
+                      value: selectedSite?.localizedName ?? LocalizedString("Tap the body to choose", comment: "Pod site placeholder when no site is selected"),
+                      valueColor: selectedSite == nil ? .secondary : .primary)
+            Divider().padding(.leading, 16)
+            detailRow(LocalizedString("Last used here", comment: "Pod site detail row label"),
+                      value: selectedSite.map { lastUsedText(for: $0) } ?? "—",
+                      valueColor: .secondary)
+            Divider().padding(.leading, 16)
+            detailRow(LocalizedString("Inserted", comment: "Pod site detail row label for insertion date"),
+                      value: Self.insertedFormatter.string(from: insertedAt),
+                      valueColor: .secondary)
+        }
+        .background(Color(UIColor.secondarySystemGroupedBackground))
+        .cornerRadius(14)
+    }
+
+    private var orientationSection: some View {
+        let choices: [PodSiteOrientation] = (selectedSite?.orientations) ?? (bodyView == .front ? [.up, .down] : [.left, .right])
+        let viewForIcons = selectedSite?.bodyView ?? bodyView
+        return VStack(alignment: .leading, spacing: 10) {
+            Text(LocalizedString("Orientation", comment: "Pod site orientation section header"))
+                .font(.footnote.weight(.semibold))
+                .textCase(.uppercase)
+                .foregroundColor(.secondary)
+                .padding(.leading, 4)
+            HStack(spacing: 10) {
+                ForEach(choices, id: \.self) { choice in
+                    let isOn = choice == activeOrientation(in: choices)
+                    Button(action: { orientation = choice }) {
+                        VStack(spacing: 4) {
+                            PodShape()
+                                .fill(Color.white)
+                                .overlay(PodShape().stroke(isOn ? Color.accentColor : Color.secondary, style: StrokeStyle(lineWidth: 2.2, lineJoin: .round)))
+                                .frame(width: 34, height: 36)
+                                .rotationEffect(.degrees(choice.screenRotation(in: viewForIcons)))
+                                .frame(width: 48, height: 48)
+                            Text(choice.localizedLabel)
+                                .font(.subheadline.weight(.semibold))
+                                .foregroundColor(.primary)
+                            Text(choice.localizedHint)
+                                .font(.caption2)
+                                .foregroundColor(.secondary)
+                        }
+                        .padding(.top, 10)
+                        .padding(.bottom, 12)
+                        .frame(maxWidth: .infinity)
+                        .background(Color(UIColor.secondarySystemGroupedBackground))
+                        .cornerRadius(12)
+                        .overlay(RoundedRectangle(cornerRadius: 12).stroke(isOn ? Color.accentColor : Color.clear, lineWidth: 2))
+                    }
+                    .buttonStyle(.plain)
+                    .accessibilityAddTraits(isOn ? .isSelected : [])
+                }
+            }
+        }
+    }
+
+    private var actionButtons: some View {
+        VStack(spacing: 10) {
+            if canSave {
+                Button(action: save) {
+                    Text(LocalizedString("Save Site", comment: "Button to save the selected pod site"))
+                        .actionButtonStyle(.primary)
+                }
+                .disabled(selectedSite == nil)
+            }
+            Button(action: finish) {
+                Text(isSetupFlow
+                     ? LocalizedString("Skip", comment: "Button to skip logging the pod site")
+                     : LocalizedString("Done", comment: "Button to close the pod site screen"))
+                    .frame(maxWidth: .infinity)
+                    .padding(.vertical, 8)
+            }
+        }
+        .padding()
+        .background(Color(UIColor.systemGroupedBackground))
+    }
+
+    // MARK: Pieces
+
+    private func siteMarker(_ site: PodSite) -> some View {
+        let center = PodSiteBodyDiagram.screenPoint(for: site.diagramPoint)
+        let isSelected = site == selectedSite
+        let siteStatus = status(for: site)
+        let ends = site.orientations          // [first end, second end]
+        let current: PodSiteOrientation? = isSelected ? orientation : nil
+        let baseRotation = ends[0].screenRotation(in: site.bodyView)
+        let firstOffset = Self.offset(forRotation: baseRotation, distance: 22)
+
+        return ZStack {
+            PodSiteArrow(
+                firstColor: isSelected ? (current == ends[0] ? Color.accentColor : PodSitePalette.inactiveEnd)  : siteStatus.color,
+                secondColor: isSelected ? (current == ends[1] ? Color.accentColor : PodSitePalette.inactiveEnd) : siteStatus.color,
+                firstEmphasized: current == ends[0],
+                secondEmphasized: current == ends[1]
+            )
+            .frame(width: 56, height: 56)
+            .rotationEffect(.degrees(baseRotation))
+            .allowsHitTesting(false)
+            .accessibilityHidden(true)
+
+            arrowEndButton(site: site, end: ends[0], status: siteStatus, isOn: current == ends[0])
+                .offset(x: firstOffset.width, y: firstOffset.height)
+            arrowEndButton(site: site, end: ends[1], status: siteStatus, isOn: current == ends[1])
+                .offset(x: -firstOffset.width, y: -firstOffset.height)
+        }
+        .frame(width: 100, height: 100)
+        .position(x: center.x, y: center.y)
+    }
+
+    private func arrowEndButton(site: PodSite, end: PodSiteOrientation, status: PodSiteStatus, isOn: Bool) -> some View {
+        Button(action: { select(site, orientation: end) }) {
+            Color.clear
+                .frame(width: 44, height: 44)
+                .contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+        .accessibilityLabel(Text("\(site.localizedName), \(end.localizedLabel), \(status.localizedDescription), \(LocalizedString("last used", comment: "Accessibility prefix for when a pod site was last used")) \(lastUsedText(for: site))"))
+        .accessibilityAddTraits(isOn ? .isSelected : [])
+    }
+
+    private func legendItem(_ color: Color, _ label: String) -> some View {
+        HStack(spacing: 6) {
+            Circle().fill(color).frame(width: 12, height: 12)
+            Text(label)
+        }
+    }
+
+    private func detailRow(_ label: String, value: String, valueColor: Color) -> some View {
+        HStack {
+            Text(label)
+            Spacer()
+            Text(value)
+                .foregroundColor(valueColor)
+                .multilineTextAlignment(.trailing)
+        }
+        .padding(.horizontal, 16)
+        .padding(.vertical, 13)
+    }
+
+    // MARK: Logic
+
+    private func select(_ site: PodSite, orientation: PodSiteOrientation) {
+        selectedSite = site
+        bodyView = site.bodyView
+        self.orientation = orientation
+    }
+
+    private func activeOrientation(in choices: [PodSiteOrientation]) -> PodSiteOrientation {
+        choices.contains(orientation) ? orientation : choices[0]
+    }
+
+    private func save() {
+        guard let site = selectedSite else { return }
+        let entry = PodSiteEntry(
+            site: site,
+            orientation: activeOrientation(in: site.orientations),
+            date: insertedAt,
+            podAddress: podAddress
+        )
+        log.record(entry)
+        finish()
+    }
+
+    private func status(for site: PodSite) -> PodSiteStatus {
+        if previousEntry?.site == site {
+            return .previousPod
+        }
+        if let lastUsed = log.lastUsed(site), insertedAt.timeIntervalSince(lastUsed) < Self.recentInterval {
+            return .recent
+        }
+        return .rested
+    }
+
+    /// The site rested longest (never-used sites first).
+    private var suggestedSite: PodSite? {
+        PodSite.allCases.min { a, b in
+            (log.lastUsed(a) ?? .distantPast) < (log.lastUsed(b) ?? .distantPast)
+        }
+    }
+
+    private func suggestionDetail(for site: PodSite) -> String {
+        guard let lastUsed = log.lastUsed(site) else {
+            return LocalizedString("Never used — tap to select", comment: "Suggested pod site detail when never used")
+        }
+        let days = Self.daysBetween(lastUsed, insertedAt)
+        return String(format: LocalizedString("Rested %1$ld days — tap to select", comment: "Suggested pod site detail (1: days since last used)"), days)
+    }
+
+    private func lastUsedText(for site: PodSite) -> String {
+        guard let lastUsed = log.lastUsed(site) else {
+            return LocalizedString("Never", comment: "Pod site never used")
+        }
+        let days = Self.daysBetween(lastUsed, insertedAt)
+        let dateText = Self.shortDateFormatter.string(from: lastUsed)
+        if days == 1 {
+            return String(format: LocalizedString("%1$@ · 1 day ago", comment: "Pod site last used (1: date)"), dateText)
+        }
+        return String(format: LocalizedString("%1$@ · %2$ld days ago", comment: "Pod site last used (1: date, 2: days ago)"), dateText, days)
+    }
+
+    private static func daysBetween(_ start: Date, _ end: Date) -> Int {
+        let calendar = Calendar.current
+        let days = calendar.dateComponents([.day], from: calendar.startOfDay(for: start), to: calendar.startOfDay(for: end)).day ?? 0
+        return max(days, 0)
+    }
+
+    /// Screen offset of the arrow end that an up-pointing arrow reaches after `rotation` degrees (clockwise).
+    private static func offset(forRotation rotation: Double, distance: CGFloat) -> CGSize {
+        let radians = rotation * Double.pi / 180
+        return CGSize(width: CGFloat(sin(radians)) * distance, height: -CGFloat(cos(radians)) * distance)
+    }
+
+    private static let shortDateFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.setLocalizedDateFormatFromTemplate("MMMd")
+        return formatter
+    }()
+
+    private static let insertedFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.setLocalizedDateFormatFromTemplate("MMMd jmm")
+        return formatter
+    }()
+
+    // MARK: Cancel
+
