+/// Pod Settings row: shows where the current pod is placed and opens the pod site screen,
+/// which is available at any time to check which site has rested longest.
+struct PodSiteSettingsRow: View {
+    let podAddress: UInt32?
+    let podActivatedAt: Date?
+
+    @ObservedObject private var log = PodSiteLog.shared
+
+    var body: some View {
+        NavigationLink(destination: PodSiteSelectionView(podAddress: podAddress, isSetupFlow: false, insertedAt: podActivatedAt)) {
+            HStack {
+                Text(LocalizedString("Pod Site", comment: "Settings row label for the logged pod site"))
+                Spacer()
+                if let entry = log.entry(forPodAddress: podAddress) {
+                    VStack(alignment: .trailing, spacing: 2) {
+                        Text(entry.site.localizedName)
+                        Text(entry.orientation.localizedLabel)
+                            .font(.footnote)
+                    }
+                    .foregroundColor(.secondary)
+                } else {
+                    Text(podAddress == nil
+                         ? LocalizedString("Best site", comment: "Pod site settings row value when no pod is active")
+                         : LocalizedString("Not logged", comment: "Pod site settings row value when the current pod's site was not logged"))
+                        .foregroundColor(.secondary)
+                }
+            }
+        }
+    }
+}
