+/// Hips and upper thighs, drawn in a fixed "diagram" coordinate space
+/// (x 56...143.5, y 180...270) and scaled up to fill the frame.
+struct PodSiteBodyDiagram: View {
+    let bodyView: PodSiteBodyView
+
+    static let origin = CGPoint(x: 56, y: 180)
+    static let scale: CGFloat = 3.2
+    static let size = CGSize(width: 280, height: 288)
+
+    static func screenPoint(for point: CGPoint) -> CGPoint {
+        CGPoint(x: (point.x - origin.x) * scale, y: (point.y - origin.y) * scale)
+    }
+
+    static var transform: CGAffineTransform {
+        CGAffineTransform(scaleX: scale, y: scale).translatedBy(x: -origin.x, y: -origin.y)
+    }
+
+    var body: some View {
+        ZStack {
+            DiagramShape(kind: .silhouette)
+                .fill(LinearGradient(
+                    gradient: Gradient(stops: [
+                        .init(color: PodSitePalette.skinShadow, location: 0),
+                        .init(color: PodSitePalette.skin, location: 0.18),
+                        .init(color: PodSitePalette.skinLight, location: 0.5),
+                        .init(color: PodSitePalette.skin, location: 0.82),
+                        .init(color: PodSitePalette.skinShadow, location: 1)
+                    ]),
+                    startPoint: .leading,
+                    endPoint: .trailing
+                ))
+            DiagramShape(kind: .silhouette)
+                .stroke(PodSitePalette.skinLine, style: StrokeStyle(lineWidth: 0.45 * Self.scale, lineJoin: .round))
+
+            if bodyView == .back {
+                glute(centerX: 81)
+                glute(centerX: 119)
+                DiagramShape(kind: .backContours)
+                    .stroke(PodSitePalette.skinLine.opacity(0.85), style: StrokeStyle(lineWidth: 0.5 * Self.scale, lineCap: .round))
+                DiagramShape(kind: .backDimples)
+                    .fill(PodSitePalette.skinShadow.opacity(0.6))
+            } else {
+                DiagramShape(kind: .frontContours)
+                    .stroke(PodSitePalette.skinLine.opacity(0.7), style: StrokeStyle(lineWidth: 0.45 * Self.scale, lineCap: .round))
+            }
+        }
+        .frame(width: Self.size.width, height: Self.size.height)
+        .accessibilityHidden(true)
+    }
+
+    private func glute(centerX: CGFloat) -> some View {
+        let center = Self.screenPoint(for: CGPoint(x: centerX, y: 214))
+        return Ellipse()
+            .fill(RadialGradient(
+                gradient: Gradient(colors: [PodSitePalette.skinLight.opacity(0.9), PodSitePalette.skinLight.opacity(0)]),
+                center: .center,
+                startRadius: 0,
+                endRadius: 20 * Self.scale
+            ))
+            .frame(width: 34 * Self.scale, height: 40 * Self.scale)
+            .position(x: center.x, y: center.y)
+    }
+
+    fileprivate static func silhouette(_ p: inout Path) {
+        p.move(to: CGPoint(x: 67, y: 178))
+        p.addCurve(to: CGPoint(x: 58.3, y: 212), control1: CGPoint(x: 65.5, y: 190), control2: CGPoint(x: 59, y: 198))
+        p.addCurve(to: CGPoint(x: 62.5, y: 272), control1: CGPoint(x: 57.6, y: 228), control2: CGPoint(x: 60.5, y: 248))
+        p.addLine(to: CGPoint(x: 97.5, y: 272))
+        p.addCurve(to: CGPoint(x: 100, y: 233), control1: CGPoint(x: 98, y: 256), control2: CGPoint(x: 98.8, y: 242))
+        p.addCurve(to: CGPoint(x: 102.5, y: 272), control1: CGPoint(x: 101.2, y: 242), control2: CGPoint(x: 102, y: 256))
+        p.addLine(to: CGPoint(x: 137.5, y: 272))
+        p.addCurve(to: CGPoint(x: 141.7, y: 212), control1: CGPoint(x: 139.5, y: 248), control2: CGPoint(x: 142.4, y: 228))
+        p.addCurve(to: CGPoint(x: 133, y: 178), control1: CGPoint(x: 141, y: 198), control2: CGPoint(x: 134.5, y: 190))
+        p.closeSubpath()
+    }
+
+    fileprivate static func frontContours(_ p: inout Path) {
+        // Hip creases toward the groin
+        p.move(to: CGPoint(x: 70.5, y: 196))
+        p.addCurve(to: CGPoint(x: 98.6, y: 230), control1: CGPoint(x: 79, y: 206), control2: CGPoint(x: 89, y: 217))
+        p.move(to: CGPoint(x: 129.5, y: 196))
+        p.addCurve(to: CGPoint(x: 101.4, y: 230), control1: CGPoint(x: 121, y: 206), control2: CGPoint(x: 111, y: 217))
+        // Hip bones
+        p.move(to: CGPoint(x: 66, y: 186))
+        p.addCurve(to: CGPoint(x: 70.5, y: 196), control1: CGPoint(x: 68, y: 190), control2: CGPoint(x: 69.5, y: 193))
+        p.move(to: CGPoint(x: 134, y: 186))
+        p.addCurve(to: CGPoint(x: 129.5, y: 196), control1: CGPoint(x: 132, y: 190), control2: CGPoint(x: 130.5, y: 193))
+        // Thigh muscle lines
+        p.move(to: CGPoint(x: 77, y: 243))
+        p.addCurve(to: CGPoint(x: 80, y: 272), control1: CGPoint(x: 79.5, y: 252), control2: CGPoint(x: 80.5, y: 261))
+        p.move(to: CGPoint(x: 123, y: 243))
+        p.addCurve(to: CGPoint(x: 120, y: 272), control1: CGPoint(x: 120.5, y: 252), control2: CGPoint(x: 119.5, y: 261))
+    }
+
+    fileprivate static func backContours(_ p: inout Path) {
+        // Spine and cleft
+        p.move(to: CGPoint(x: 100, y: 178))
+        p.addLine(to: CGPoint(x: 100, y: 194))
+        p.move(to: CGPoint(x: 100, y: 199))
+        p.addCurve(to: CGPoint(x: 100, y: 233), control1: CGPoint(x: 100.2, y: 211), control2: CGPoint(x: 100, y: 222))
+        // Gluteal folds
+        p.move(to: CGPoint(x: 63, y: 236))
+        p.addCurve(to: CGPoint(x: 99, y: 238), control1: CGPoint(x: 71, y: 245.5), control2: CGPoint(x: 87, y: 247.5))
+        p.move(to: CGPoint(x: 137, y: 236))
+        p.addCurve(to: CGPoint(x: 101, y: 238), control1: CGPoint(x: 129, y: 245.5), control2: CGPoint(x: 113, y: 247.5))
+        // Hip outline hints
+        p.move(to: CGPoint(x: 60, y: 205))
+        p.addCurve(to: CGPoint(x: 71, y: 190), control1: CGPoint(x: 63, y: 198), control2: CGPoint(x: 67, y: 193))
+        p.move(to: CGPoint(x: 140, y: 205))
+        p.addCurve(to: CGPoint(x: 129, y: 190), control1: CGPoint(x: 137, y: 198), control2: CGPoint(x: 133, y: 193))
+    }
+
+    fileprivate static func backDimples(_ p: inout Path) {
+        p.addEllipse(in: CGRect(x: 91.4, y: 188.9, width: 3.2, height: 2.2))
+        p.addEllipse(in: CGRect(x: 105.4, y: 188.9, width: 3.2, height: 2.2))
+    }
+
+    /// A shape drawn in diagram coordinates and scaled into the diagram frame.
+    private struct DiagramShape: Shape {
+        enum Kind {
+            case silhouette
+            case frontContours
+            case backContours
+            case backDimples
+        }
+
+        let kind: Kind
+
+        func path(in rect: CGRect) -> Path {
+            var path = Path()
+            switch kind {
+            case .silhouette: PodSiteBodyDiagram.silhouette(&path)
+            case .frontContours: PodSiteBodyDiagram.frontContours(&path)
+            case .backContours: PodSiteBodyDiagram.backContours(&path)
+            case .backDimples: PodSiteBodyDiagram.backDimples(&path)
+            }
+            return path.applying(PodSiteBodyDiagram.transform)
+        }
+    }
+}
